# ================================================
# Linea Jewelry - Environment Variables
# ================================================
# Copy this file to .env.local and fill in values
# NEVER commit .env files with real secrets!
# ================================================

# API Configuration
# Set to your backend API endpoint
VITE_API_URL=http://localhost:3000/api

# API Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# ================================================
# Payment Gateway
# ================================================

# Stripe Public Key
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# PayPal Client ID (if using PayPal)
# Get from: https://developer.paypal.com
VITE_PAYPAL_CLIENT_ID=...

# ================================================
# Analytics & Monitoring
# ================================================

# Google Analytics
VITE_ANALYTICS_ID=G-...

# Sentry Error Tracking
VITE_SENTRY_DSN=https://...@sentry.io/...

# ================================================
# Feature Flags
# ================================================

# Enable/disable checkout functionality
VITE_ENABLE_CHECKOUT=true

# Enable/disable wishlist feature
VITE_ENABLE_WISHLIST=false

# Enable/disable user authentication
VITE_ENABLE_AUTH=false

# ================================================
# Application Settings
# ================================================

# Environment: development, staging, production
VITE_ENV=development

# Enable debug mode (verbose logging)
VITE_DEBUG=false

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# ================================================
# Social & External Services
# ================================================

# Instagram Handle (for social links)
VITE_INSTAGRAM_HANDLE=linea_jewelry

# Newsletter API (e.g., Mailchimp)
VITE_NEWSLETTER_API_KEY=...

# ================================================
# Localization
# ================================================

# Default language: en, es, fr, etc.
VITE_DEFAULT_LANG=en

# Supported languages
VITE_SUPPORTED_LANGS=en,es,fr

# ================================================
# Notes for Development
# ================================================
# 1. Create .env.local from this template
# 2. Set values for your environment
# 3. Never commit .env.local
# 4. For production, set these in your CI/CD platform
# 5. Use different keys for dev, staging, prod
# ================================================
